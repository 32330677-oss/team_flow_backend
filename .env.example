# Team Flow backend - environment variables
# Copy to .env for local development:  cp .env.example .env
# Never commit .env. On Render, set these under Environment.

# --- Server -----------------------------------------------------------------
PORT=5000
# "production" on the server: Express then never sends stack traces to clients.
NODE_ENV=development
# Required. Long random string (signs login tokens).
JWT_SECRET=
# Comma-separated web origins allowed by CORS (only needed for a web build).
# Empty = every origin allowed. Mobile/desktop apps are not affected.
CORS_ORIGIN=
# Business time zone used for "today" in attendance (default Asia/Damascus).
APP_TIME_ZONE=Asia/Damascus
# Public URL of this API, used in QR codes on printed documents.
PUBLIC_BASE_URL=

# --- Database (MySQL 8) -----------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# "true" for Aiven / any hosted MySQL that requires SSL.
DB_SSL=true
# Aiven CA certificate, so the server certificate is verified.
# Path to ca.pem (Render Secret File: /etc/secrets/ca.pem) ...
DB_CA_CERT_PATH=
# ... or the PEM text itself (\n allowed). Leave both empty to skip verification.
DB_CA_CERT=

# --- Email (forgot password) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- File storage (worker photos, documents, biometric files) ---------------
# "s3" in production, "local" for development (files under UPLOAD_DIR).
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=worker-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Printed documents ------------------------------------------------------
# Secret for the verification code on electronic stamps (falls back to JWT_SECRET).
DOC_STAMP_SECRET=
COMPANY_NAME=
COMPANY_INFO=

# --- Biometric connector ----------------------------------------------------
# Shared token between this backend and the connector (32+ characters).
ATTENDANCE_CONNECTOR_TOKEN=
# Folder of the bundled connector, relative to the backend root.
BIOMETRIC_CONNECTOR_DIR=connector
# Optional. Default http://127.0.0.1:$PORT
BIOMETRIC_CONNECTOR_API_URL=
BIOMETRIC_MAX_PUNCH_AGE_DAYS=30
BIOMETRIC_STALE_BATCH_MINUTES=60

# --- Equipment Flow (ASIK) link: combined Project Daily Report ------------
# Base URL of the equipment API (ends with /api) and the shared token
# (= INTEGRATION_TOKEN on the equipment server, 32+ characters).
# Empty = the report is still generated, with the plant section empty.
EQUIPMENT_API_URL=
EQUIPMENT_INTEGRATION_TOKEN=
EQUIPMENT_API_TIMEOUT_MS=15000

# --- Rate limits (optional) -------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_DOC_RATE_LIMIT_MAX=60

# --- In-app AI assistant (optional; off when the key is empty) --------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_MAX_TOKENS=700
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_RATE_LIMIT_MAX=30

# --- One-off: scripts/seedAdmin.js (creates the first Admin) ----------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_EMAIL=

# --- Tests (npm test; needs a local MySQL) ----------------------------------
TEST_DB_NAME=team_flow_test
TEST_MYSQL_CLI=mysql -uroot
